#!/usr/bin/env bash
# ccx — dispatch a task to a Grok 4.6 worker and return a small, schema-validated envelope.
#
# Uses the Grok Build CLI's OAuth session (your grok.com subscription).
# No XAI_API_KEY, no pay-as-you-go billing.
#
# Design contract:
#   1. The orchestrator ships a BRIEF, never context. The worker reads files itself.
#   2. stdout stays SMALL (envelope only). Full transcript goes to the run dir.
#   3. Safety is pinned per-invocation via the kernel sandbox, never inherited
#      from ~/.grok/config.toml (which may be yolo/always-approve).
set -euo pipefail
unset CDPATH  # else `cd "$x" && pwd` echoes the resolved path too, doubling CWD

VERSION="0.1.0"
CCX_HOME="${CCX_HOME:-$HOME/.ccxai}"
GROK_BIN="${GROK_BIN:-$(command -v grok 2>/dev/null || echo "$HOME/.grok/bin/grok")}"

MODEL="${CCX_MODEL:-grok-4.6}"
EFFORT="${CCX_EFFORT:-xhigh}"
TIMEOUT="${CCX_TIMEOUT:-1800}"
MAX_OUT="${CCX_MAX_OUT:-16000}"

die() { printf 'ccx: %s\n' "$*" >&2; exit 2; }
have() { command -v "$1" >/dev/null 2>&1; }
# md5 of stdin as lowercase hex; GNU coreutils and BSD spell it differently.
_md5() { if have md5sum; then md5sum | cut -d' ' -f1; else md5 -q; fi; }

# ccx can be SIGKILLed (harness limit, ctrl-c, sleep) -- untrappable, so the post-dispatch
# write never happens and meta.json stays "running" forever while the detached worker often
# finishes and bills. Repair those records from whatever the worker actually left on disk.
_reconcile() {
  local d m age budget src c now
  [[ -d "$CCX_HOME/runs" ]] || return 0
  now=$(date +%s)
  for d in "$CCX_HOME"/runs/*/; do
    m="$d/meta.json"; [[ -f "$m" ]] || continue
    [[ "$(jq -r '.status // ""' "$m" 2>/dev/null)" == "running" ]] || continue
    # never touch a run that could still legitimately be in flight
    budget=$(jq -r '.timeout_s // 1800' "$m" 2>/dev/null)
    age=$(( now - $(_mtime "$m") ))
    (( age > budget + 600 )) || continue
    src=""
    for c in raw.json raw2.json raw1.json; do
      [[ -s "$d$c" ]] && jq -e . >/dev/null 2>&1 <"$d$c" && { src="$d$c"; break; }
    done
    if [[ -n "$src" ]]; then
      jq -s --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
        .[0] + {ts:$ts, status:"recovered",
                cost:(.[1].total_cost_usd // 0), turns:(.[1].num_turns // 0),
                stop_reason:(.[1].stopReason // "?"), seconds:0,
                phase1_seconds:0, phase2_seconds:0, brief_bytes:0, exit_code:0,
                grok:(.[0].grok // "?"), label:(.[0].label // "recovered"),
                sub:"run", warnings:["reconciled: dispatcher died, worker result recovered"],
                cmd:[]}' "$m" "$src" > "$m.tmp" && mv "$m.tmp" "$m"
      jq -c '{ts,run,label,sub,status,profile,effort,cost,turns,seconds,phase1_seconds,
              phase2_seconds,brief_bytes,exit_code,warnings,grok,cwd}' "$m" \
        >> "$CCX_HOME/runs.jsonl" 2>/dev/null || true
    else
      jq '.status="abandoned" | .warnings=["dispatcher died with no worker result"]' \
        "$m" > "$m.tmp" && mv "$m.tmp" "$m"
    fi
  done
}
_mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }

usage() {
cat <<'EOF'
ccx — Grok 4.6 worker dispatch (orchestrator-worker)

USAGE
  ccx run     [opts] (--task FILE | -- <brief text>)   dispatch a fresh worker
  ccx cont    --session <uuid> [opts] (--task FILE | -- <text>)
                                                       continue an existing worker
  ccx show    <run-id> [--transcript|--envelope|--meta] inspect a past run
  ccx ls      [-n N]                                   list recent runs
  ccx stats   [--days N] [--label L]                   aggregate spend, timing, failures
                                                       (--label-filter is an alias)
  ccx log     [-n N]                                   raw JSONL event log (one line/run)
  ccx export  [--all]                                  ship runs to an OTLP collector
  ccx doctor                                           check the setup

PROFILES  (kernel-enforced, macOS Seatbelt / Linux Landlock)
  --read      DEFAULT. sandbox=read-only: reads anything, writes NOTHING to the
              filesystem. Full toolset incl. shell is safe here.
              NOTE: network is NOT blocked on macOS (Seatbelt no-ops it; the
              grok docs' "child network blocked" is Linux/Landlock only).
  --write     sandbox=workspace: writes confined to the run cwd (+/tmp).
              Adds a deny list for push/sudo/gh/rm. Use with --worktree.

OPTIONS
  --task FILE       brief file ('-' for stdin). Or pass the brief after '--'.
  --cwd DIR         working directory for the worker (default: $PWD)
  --worktree NAME   create/reuse a git worktree and run there (implies --write)
  --ref REF         base ref for a new worktree (default HEAD)
  --schema FILE     JSON Schema for the return envelope (default: built-in)
  --no-schema       free-form prose instead of a validated envelope
  --schema-inline   constrain the worker's own turn (1 call, but the schema can
                    hijack turn 1 and return an empty answer -- not recommended)
  --model ID        default grok-4.6
  --effort LEVEL    low|medium|high|xhigh   (default xhigh)
  --max-turns N     default 30 (read) / 60 (write)
  --timeout SEC     default 1800
  --tools LIST      override the built-in tool allowlist
  --allow RULE      extra permission allow rule (repeatable)
  --deny RULE       extra permission deny rule (repeatable)
  --web             permit web_search / web_fetch (off by default)
  --mcp             permit MCP tools (off by default: MCP servers run OUTSIDE
                    the sandbox, so they can write to remote systems)
  --label TEXT      label for the run directory
  --raw             print only the envelope JSON (no header)
  --check           require the worker to verify its own work before returning

EXIT CODES
  0 done|partial   3 blocked   4 timeout   5 worker/parse error
EOF
}

# ---------- default envelope ----------
read -r -d '' DEFAULT_SCHEMA <<'EOF' || true
{"type":"object","additionalProperties":false,
 "required":["status","summary","files_changed","evidence","open_questions"],
 "properties":{
  "status":{"type":"string","enum":["done","partial","blocked"]},
  "summary":{"type":"string","description":"Under 120 words: what you did and why."},
  "files_changed":{"type":"array","items":{"type":"object","additionalProperties":false,
    "required":["path","what"],
    "properties":{"path":{"type":"string"},"what":{"type":"string"}}}},
  "evidence":{"type":"array","items":{"type":"string"},
    "description":"Commands you actually ran and their real results, e.g. 'pytest -q -> 41 passed'."},
  "open_questions":{"type":"array","items":{"type":"string"}},
  "next_steps":{"type":"array","items":{"type":"string"}}}}
EOF

read -r -d '' WORKER_RULES <<'EOF' || true
You are a WORKER dispatched by an orchestrator agent. Operating rules:
- You will NOT get a mid-run answer to any question. Do not ask for clarification.
  If genuinely blocked, stop and return status="blocked" with specific open_questions.
- The orchestrator reads ONLY your returned envelope, never your transcript.
  Everything that matters must be in the envelope.
- evidence[] must contain commands you ACTUALLY ran and their REAL output verdicts.
  Never claim a test passed that you did not run. An honest "partial" beats a false "done".
- Prefer reading the real code over assuming. You have a large context; use it.
- Keep summary under 120 words.
EOF

# ---------- arg parsing ----------
SUB="${1:-}"; [[ -n "$SUB" ]] || { usage; exit 2; }; shift || true
case "$SUB" in -h|--help|help) usage; exit 0 ;; -v|--version) echo "ccx $VERSION"; exit 0 ;; esac

PROFILE=read; PROFILE_SET=0; CWD_SET=0; MCP=0
TASK_FILE=""; BRIEF=""; CWD="$PWD"; WORKTREE=""; REF="HEAD"
SCHEMA_FILE=""; USE_SCHEMA=1; MAX_TURNS=""; TOOLS=""; WEB=0; LABEL=""
RAW=0; CHECK=0; SESSION=""; SHOW_WHAT="envelope"; LSN=15; SCHEMA_INLINE=0
DAYS=""; LABELF=""; EXPORT_ALL=0
declare -a XALLOW=() XDENY=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --read)       PROFILE=read;  PROFILE_SET=1; shift ;;
    --write)      PROFILE=write; PROFILE_SET=1; shift ;;
    --task)       TASK_FILE="${2:?}"; shift 2 ;;
    --cwd)        CWD="${2:?}"; CWD_SET=1; shift 2 ;;
    --worktree)   WORKTREE="${2:?}"; shift 2 ;;
    --ref)        REF="${2:?}"; shift 2 ;;
    --schema)     SCHEMA_FILE="${2:?}"; shift 2 ;;
    --no-schema)  USE_SCHEMA=0; shift ;;
    --schema-inline) SCHEMA_INLINE=1; shift ;;
    --model)      MODEL="${2:?}"; shift 2 ;;
    --effort)     EFFORT="${2:?}"; shift 2 ;;
    --max-turns)  MAX_TURNS="${2:?}"; shift 2 ;;
    --timeout)    TIMEOUT="${2:?}"; shift 2 ;;
    --tools)      TOOLS="${2:?}"; shift 2 ;;
    --allow)      XALLOW+=("${2:?}"); shift 2 ;;
    --deny)       XDENY+=("${2:?}"); shift 2 ;;
    --web)        WEB=1; shift ;;
    --mcp)        MCP=1; shift ;;
    --label)      LABEL="${2:?}"; shift 2 ;;
    --raw)        RAW=1; shift ;;
    --check)      CHECK=1; shift ;;
    --session)    SESSION="${2:?}"; shift 2 ;;
    -n)           LSN="${2:?}"; shift 2 ;;
    --days)       DAYS="${2:?}"; shift 2 ;;
    --all)        EXPORT_ALL=1; shift ;;
    --label-filter) LABELF="${2:?}"; shift 2 ;;
    --transcript) SHOW_WHAT=transcript; shift ;;
    --envelope)   SHOW_WHAT=envelope; shift ;;
    --meta)       SHOW_WHAT=meta; shift ;;
    --)           shift; BRIEF="$*"; break ;;
    -*)           die "unknown option: $1" ;;
    *)            BRIEF="${BRIEF:+$BRIEF }$1"; shift ;;
  esac
done

# ---------- subcommands that don't dispatch ----------
if [[ "$SUB" == "doctor" ]]; then
  echo "ccx $VERSION"
  printf '%-14s %s\n' "grok:" "$([[ -x "$GROK_BIN" ]] && "$GROK_BIN" --version 2>/dev/null || echo 'MISSING')"
  printf '%-14s %s\n' "auth:" "$("$GROK_BIN" models 2>&1 | head -1)"
  for t in jq git timeout uuidgen; do
    printf '%-14s %s\n' "$t:" "$(have "$t" && command -v "$t" || echo 'MISSING')"; done
  printf '%-14s %s\n' "runs:" "$CCX_HOME/runs"
  printf '%-14s %s\n' "defaults:" "$MODEL / effort=$EFFORT / timeout=${TIMEOUT}s"
  gy=$(grep -cE '^(yolo|permission_mode)' ~/.grok/config.toml 2>/dev/null | head -1); gy="${gy:-0}"
  [[ "$gy" -gt 0 ]] && echo "note:          ~/.grok/config.toml sets yolo/permission_mode; ccx overrides these per run."
  mc=$(grep -cE '^\[mcp_servers' ~/.grok/config.toml 2>/dev/null | head -1); mc="${mc:-0}"
  [[ "$mc" -gt 0 ]] && echo "note:          $mc MCP server(s) configured; ccx denies them by default (--mcp to allow)."
  exit 0
fi

if [[ "$SUB" == "ls" ]]; then
  _reconcile
  [[ -d "$CCX_HOME/runs" ]] || { echo "no runs yet"; exit 0; }
  ls -1t "$CCX_HOME/runs" 2>/dev/null | head -"$LSN" | while IFS= read -r d; do
    m="$CCX_HOME/runs/$d/meta.json"
    if [[ -f "$m" ]]; then
      jq -r --arg d "$d" '"\($d)  \(.status // "?")  turns=\(.turns // "?")  $\(.cost // 0)  \(.session // "-")"' "$m"
    else echo "$d  (incomplete)"; fi
  done
  exit 0
fi

if [[ "$SUB" == "log" ]]; then
  _reconcile
  [[ -f "$CCX_HOME/runs.jsonl" ]] || { echo "no runs logged yet"; exit 0; }
  tail -"$LSN" "$CCX_HOME/runs.jsonl"
  exit 0
fi

if [[ "$SUB" == "stats" ]]; then
  _reconcile
  L="$CCX_HOME/runs.jsonl"
  [[ -f "$L" ]] || { echo "no runs logged yet (runs before instrumentation are not included)"; exit 0; }
  CUT=""
  [[ -n "$DAYS" ]] && CUT=$(date -u -v-"${DAYS}"d +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
                            || date -u -d "${DAYS} days ago" +%Y-%m-%dT%H:%M:%SZ)
  LABF="${LABELF:-$LABEL}"
  jq -s --arg cut "$CUT" --arg lab "$LABF" '
    map(select(($cut == "" or .ts >= $cut) and ($lab == "" or .label == $lab)))
    | if length == 0 then "no runs match" else
    { runs: length,
      total_usd: (map(.cost // 0) | add | .*10000 | round | ./10000),
      usd_per_run: ((map(.cost // 0) | add / length) * 10000 | round | ./10000),
      wall_clock_min: ((map(.seconds // 0) | add) / 60 | round),
      by_status:  (group_by(.status // "unknown")
                   | map({(.[0].status // "unknown"): length}) | add),
      by_profile: (group_by(.profile // "unknown")
                   | map({(.[0].profile // "unknown"): length}) | add),
      spend_by_label: (group_by(.label // "unknown")
                       | map({(.[0].label // "unknown"):
                              ((map(.cost // 0)|add)*10000|round|./10000)}) | add),
      seconds: (map(.seconds // 0) | sort |
                {p50: .[(length/2|floor)], p90: .[(length*0.9|floor)], max: .[length-1]}),
      phase2_overhead_pct: ((map(.phase2_seconds // 0) | add) as $p2
                            | (map(.seconds // 0) | add) as $t
                            | if $t > 0 then ($p2 / $t * 1000 | round / 10) else 0 end),
      incomplete_records: (map(select(
                             (has("status")|not) or (has("cost")|not) or
                             (has("label")|not) or (has("warnings")|not))) | length),
      runs_with_warnings: (map(select((.warnings // []) | length > 0)) | length),
      warnings: (map((.warnings // [])[]) | group_by(.)
                 | map({(.[0]|split(":")[0]): length}) | add) }
    end' "$L"
  { echo
    echo "recent failures / warnings:"
    jq -r --arg cut "$CUT" --arg lab "$LABF" '
      select(($cut == "" or .ts >= $cut) and ($lab == "" or (.label // "") == $lab))
      | select((((.status // "") | test("blocked|timeout|killed")))
               or (((.warnings // []) | length) > 0))
      | "  \(.ts)  \(.run)  \(.status // "?")  \((.warnings // []) | join("; "))"' \
      "$L" | tail -8
  } >&2
  exit 0
fi

if [[ "$SUB" == "export" ]]; then
  # OTLP is an EXPORT of the local log, never the source of truth: the JSONL must
  # survive a collector being down, and the hot path must never block on a network call.
  EP="${OTEL_EXPORTER_OTLP_ENDPOINT:-}"
  [[ -n "$EP" ]] || die "set OTEL_EXPORTER_OTLP_ENDPOINT (e.g. https://collector:4318)"
  L="$CCX_HOME/runs.jsonl"; [[ -f "$L" ]] || { echo "nothing to export"; exit 0; }
  CUR="$CCX_HOME/.export-cursor"; SEEN="$CCX_HOME/.export-seen"

  # mkdir is atomic, so it doubles as a lock. Two concurrent exports would otherwise
  # both read the same pending set and both POST it.
  LOCK="$CCX_HOME/.export.lock"
  mkdir "$LOCK" 2>/dev/null || die "another ccx export is running (stale? rmdir $LOCK)"
  trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT

  LAST=$([[ -f "$CUR" && "$EXPORT_ALL" -eq 0 ]] && cat "$CUR" || echo "")
  SEEN_JSON='[]'
  [[ -f "$SEEN" && "$EXPORT_ALL" -eq 0 ]] && SEEN_JSON=$(jq -R . "$SEEN" | jq -sc .)

  # Parse tolerantly. This log is append-only and gets written by more than one path,
  # so a single malformed line must not permanently wedge every future export.
  TOTAL=$(grep -c . "$L" || echo 0)
  PARSED=$(jq -R -c 'fromjson? // empty' "$L")
  NPARSED=$(printf '%s' "$PARSED" | grep -c . || echo 0)
  VALID=$(printf '%s\n' "$PARSED" | jq -c 'select((.ts|type)=="string" and (.run|type)=="string")')
  NVALID=$(printf '%s' "$VALID" | grep -c . || echo 0)
  (( TOTAL - NPARSED > 0 )) && echo "ccx: skipped $((TOTAL-NPARSED)) unparseable line(s) in runs.jsonl" >&2
  (( NPARSED - NVALID > 0 )) && echo "ccx: skipped $((NPARSED-NVALID)) record(s) missing ts/run" >&2

  # `.ts` has 1-second resolution, so a strict `>` would permanently drop a run that
  # landed in the same second as the cursor. Take `>=` and exclude ids already sent.
  PEND=$(printf '%s\n' "$VALID" | jq -c --arg last "$LAST" --argjson seen "$SEEN_JSON" '
    select($last == "" or .ts > $last or (.ts == $last and ([.run] | inside($seen) | not)))')
  [[ -n "$PEND" ]] || { echo "up to date (cursor ${LAST:-none})"; exit 0; }
  N=$(printf '%s' "$PEND" | grep -c .)

  # Derive ids by hashing, not by transcoding the run name: the previous scheme mapped
  # most characters to "0", leaving a near-constant 16-char prefix, so spanIds collided.
  PEND=$(printf '%s\n' "$PEND" | while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    _r=$(jq -r '.run' <<<"$line")
    _t=$(printf 'ccx-trace:%s' "$_r" | _md5 | cut -c1-32)
    _s=$(printf 'ccx-span:%s'  "$_r" | _md5 | cut -c1-16)
    jq -c --arg t "$_t" --arg s "$_s" '. + {_tid:$t, _sid:$s}' <<<"$line"
  done)

  BODY=$(printf '%s\n' "$PEND" | jq -s --arg svc "ccx" '{
    resourceSpans: [{
      resource: {attributes: [
        {key:"service.name",  value:{stringValue:$svc}},
        {key:"service.version",value:{stringValue:"0.1.0"}}]},
      scopeSpans: [{ scope: {name:"ccx"}, spans: (map(
        (.ts | strptime("%Y-%m-%dT%H:%M:%SZ") | mktime) as $st |
        {
          traceId: ._tid,
          spanId:  ._sid,
          name: ("ccx." + (.sub // "run")),
          kind: 3,
          startTimeUnixNano: ($st * 1000000000 | tostring),
          endTimeUnixNano:   (($st + (.seconds // 0)) * 1000000000 | tostring),
          status: {code: (if .status == "done" then 1 else 2 end)},
          attributes: [
            {key:"ccx.run",     value:{stringValue:.run}},
            {key:"ccx.label",   value:{stringValue:(.label // "unknown")}},
            {key:"ccx.profile", value:{stringValue:(.profile // "unknown")}},
            {key:"ccx.effort",  value:{stringValue:(.effort // "unknown")}},
            {key:"ccx.status",  value:{stringValue:(.status // "unknown")}},
            {key:"ccx.model",   value:{stringValue:(.model // "grok-4.6")}},
            {key:"ccx.grok_version", value:{stringValue:(.grok // "unknown")}},
            {key:"ccx.cost_usd",value:{doubleValue:(.cost // 0)}},
            {key:"ccx.turns",   value:{intValue:((.turns // 0)|tostring)}},
            {key:"ccx.phase1_seconds",value:{intValue:((.phase1_seconds // 0)|tostring)}},
            {key:"ccx.phase2_seconds",value:{intValue:((.phase2_seconds // 0)|tostring)}},
            {key:"ccx.brief_bytes",   value:{intValue:((.brief_bytes // 0)|tostring)}},
            {key:"ccx.warning_count", value:{intValue:(((.warnings // [])|length)|tostring)}}
          ]
        }))}]}]}')

  # OTEL_EXPORTER_OTLP_HEADERS is spec'd as comma-separated key=value pairs; passing it
  # raw to curl -H only works for a single "Key: value" string.
  declare -a HDRS=()
  if [[ -n "${OTEL_EXPORTER_OTLP_HEADERS:-}" ]]; then
    IFS=',' read -ra _kvs <<< "$OTEL_EXPORTER_OTLP_HEADERS"
    for _kv in "${_kvs[@]}"; do
      _kv="${_kv#"${_kv%%[![:space:]]*}"}"
      if [[ "$_kv" == *"="* ]]; then HDRS+=(-H "${_kv%%=*}: ${_kv#*=}")
      elif [[ -n "$_kv" ]];   then HDRS+=(-H "$_kv"); fi
    done
  fi

  # A fixed path in shared /tmp is both a symlink-truncation target and a collision
  # between concurrent exports under different CCX_HOME values (the lock is per-home).
  RESP=$(mktemp "${TMPDIR:-/tmp}/ccx-otlp.XXXXXX")
  trap 'rmdir "$LOCK" 2>/dev/null || true; rm -f "$RESP" 2>/dev/null || true' EXIT
  CODE=$(printf '%s' "$BODY" | curl -sS -o "$RESP" -w '%{http_code}' \
    -X POST "${EP%/}/v1/traces" -H 'Content-Type: application/json' \
    ${HDRS+"${HDRS[@]}"} --data-binary @- 2>/dev/null) || CODE=000
  if [[ "$CODE" =~ ^2 ]]; then
    NEWLAST=$(printf '%s\n' "$PEND" | jq -r .ts | sort | tail -1)
    if [[ "$NEWLAST" == "$LAST" && -f "$SEEN" ]]; then cp "$SEEN" "$SEEN.tmp"; else : > "$SEEN.tmp"; fi
    printf '%s\n' "$PEND" | jq -r --arg t "$NEWLAST" 'select(.ts == $t) | .run' >> "$SEEN.tmp"
    sort -u "$SEEN.tmp" > "$SEEN"; rm -f "$SEEN.tmp"
    printf '%s\n' "$NEWLAST" > "$CUR"
    echo "exported $N span(s) to ${EP%/}/v1/traces (HTTP $CODE); cursor -> $NEWLAST"
  else
    echo "export failed (HTTP $CODE) -- local log intact, retry later" >&2
    head -c 300 "$RESP" >&2; echo >&2; exit 1
  fi
  exit 0
fi

if [[ "$SUB" == "show" ]]; then
  RUN="${BRIEF#"${BRIEF%%[![:space:]]*}"}"; RUN="${RUN%"${RUN##*[![:space:]]}"}"
  [[ -n "$RUN" ]] || die "usage: ccx show <run-id>"
  case "$RUN" in *[[:space:]]*) die "run id must be a single token (got: $RUN)" ;; esac
  D="$CCX_HOME/runs/$RUN"; [[ -d "$D" ]] || die "no such run: $RUN"
  case "$SHOW_WHAT" in
    transcript)
      src="$D/raw1.json"; [[ -f "$src" ]] || src="$D/raw.json"
      jq -r '"--- reasoning ---\n" + (.thought // "(none captured)") +
             "\n\n--- final text ---\n" + (.text // "(none)")' "$src"
      echo; echo "note: ccx stores the worker's reasoning and final text, not its tool calls."
      echo "      the full tool loop lives in ~/.grok/sessions/, keyed by cwd and session id."
      jq -r '"      session: " + (.session // "-")' "$D/meta.json" 2>/dev/null ;;
    meta)       cat "$D/meta.json" ;;
    *)  # a kill between phases leaves raw.json absent while raw2 holds the envelope
        cat "$D/envelope.json" 2>/dev/null \
          || jq -e '.structuredOutput' "$D/raw2.json" 2>/dev/null \
          || jq -r '.text' "$D/raw.json" 2>/dev/null \
          || jq -r '.text' "$D/raw1.json" 2>/dev/null \
          || die "run $RUN has no readable result" ;;
  esac
  exit 0
fi

[[ "$SUB" == "run" || "$SUB" == "cont" ]] || die "unknown subcommand: $SUB"
[[ -x "$GROK_BIN" ]] || die "grok CLI not found (set GROK_BIN)"
have jq || die "jq is required"
GROK_VER="$("$GROK_BIN" --version 2>/dev/null | awk '{print $2}')"
if [[ "$USE_SCHEMA" -eq 1 ]] && ! "$GROK_BIN" --help 2>&1 | grep -q -- '--json-schema'; then
  die "this grok build ($GROK_VER) has no --json-schema; use --no-schema or pin an older grok"
fi
[[ "$SUB" == "cont" && -z "$SESSION" ]] && die "ccx cont requires --session <uuid>"
[[ "$SUB" == "run"  && -n "$SESSION" ]] && die "--session resumes an existing worker; use: ccx cont --session $SESSION"

# A worktree exists to contain writes; asking for read as well is a contradiction, and
# silently resolving it either way produced a worker with the wrong powers.
if [[ -n "$WORKTREE" ]]; then
  [[ "$PROFILE_SET" -eq 1 && "$PROFILE" == "read" ]] &&
    die "--read and --worktree conflict (a worktree is for writes). Choose one."
  PROFILE=write; PROFILE_SET=1   # explicit: cont's inherit must not overwrite this
fi

# Resuming a session under a different sandbox than it was created with is refused by
# grok, and resuming a worktree run from $PWD would write to the main checkout.
if [[ "$SUB" == "cont" ]]; then
  PARENT="$(grep -l -- "$SESSION" "$CCX_HOME"/runs/*/meta.json 2>/dev/null | tail -1)"
  if [[ -n "$PARENT" ]]; then
    [[ "$PROFILE_SET" -eq 0 ]] && PROFILE="$(jq -r '.profile // "read"' "$PARENT")"
    [[ "$CWD_SET" -eq 0 ]] && { pc="$(jq -r '.cwd // empty' "$PARENT")"; [[ -d "$pc" ]] && CWD="$pc"; }
  elif [[ "$PROFILE_SET" -eq 0 ]]; then
    echo "ccx: warning: no local record of session $SESSION; assuming --read profile and cwd $PWD" >&2
  fi
fi

# ---------- brief ----------
if [[ -n "$TASK_FILE" ]]; then
  if [[ "$TASK_FILE" == "-" ]]; then BRIEF="$(cat)"; else
    [[ -f "$TASK_FILE" ]] || die "no such task file: $TASK_FILE"; BRIEF="$(cat "$TASK_FILE")"; fi
fi
[[ -n "${BRIEF// /}" ]] || die "empty brief (use --task FILE, '-' for stdin, or -- <text>)"

# --check is implemented in the brief, not as a CLI flag: grok removed --check in 1.0.x.
if [[ "$CHECK" -eq 1 ]]; then
  BRIEF="$BRIEF

SELF-VERIFICATION (required before you return):
re-read every file you changed, re-run the acceptance command, and state the real
result in evidence[]. If verification fails and you cannot fix it, return status=\"partial\"."
fi

# ---------- worktree ----------
if [[ -n "$WORKTREE" ]]; then
  have git || die "git required for --worktree"
  case "$WORKTREE" in *[!A-Za-z0-9._-]*|""|.|..)
    die "--worktree name must match [A-Za-z0-9._-]+ (got: $WORKTREE)" ;; esac
  REPO="$(git -C "$CWD" rev-parse --show-toplevel 2>/dev/null)" || die "--worktree needs a git repo at $CWD"
  WT="$CCX_HOME/worktrees/$(basename "$REPO")-$WORKTREE"
  if [[ -d "$WT" ]]; then
    # A pre-existing directory that is not our worktree would silently become the
    # write target, defeating the isolation the flag promises.
    git -C "$WT" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
      || die "$WT exists but is not a git worktree; remove it or pick another name"
    # --path-format=absolute is required: plain --git-common-dir returns a RELATIVE
    # ".git" from the main checkout, which -ef then resolves against the caller's cwd
    # rather than the repo, rejecting every legitimate worktree reuse.
    wt_common="$(git -C "$WT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
    repo_common="$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
    [[ -n "$wt_common" && "$wt_common" -ef "$repo_common" ]] \
      || die "$WT is a worktree of a different repository"
  else
    mkdir -p "$(dirname "$WT")"
    git -C "$REPO" worktree add -b "ccx/$WORKTREE" "$WT" "$REF" >/dev/null 2>&1 \
      || git -C "$REPO" worktree add "$WT" "$REF" >/dev/null \
      || die "could not create worktree $WT"
  fi
  CWD="$WT"
fi
[[ -d "$CWD" ]] || die "no such directory: $CWD"
CWD="$(cd "$CWD" && pwd)"

if [[ "$PROFILE" == "read" ]]; then
  case "$CWD/" in
    /tmp/*|/private/tmp/*|/var/tmp/*|/private/var/folders/*|"${TMPDIR:-/nonexistent-tmpdir}"*)
      die "--read cwd is on a path every sandbox profile leaves writable ($CWD).
     The read-only guarantee does not hold there. Use a cwd outside temp, or --write." ;;
  esac
fi

# ---------- profile ----------
# SAFE holds everything that CONTAINS the worker. Both phases must carry all of it:
# phase 2 previously rebuilt this by hand and silently dropped permission-mode, the
# allow rule, 9 of 10 deny rules and the Agent block -- falling back to whatever
# ~/.grok/config.toml says, which is the exact inheritance ccx exists to prevent.
declare -a SAFE=() ARGS=()
if [[ "$PROFILE" == "write" ]]; then
  SANDBOX=workspace
  SAFE+=(--sandbox "$SANDBOX" --permission-mode acceptEdits --allow "Bash")
  SAFE+=(--deny "Bash(sudo*)" --deny "Bash(rm -rf /*)" --deny "Bash(git push*)"
         --deny "Bash(git reset --hard*)" --deny "Bash(gh*)" --deny "Bash(npm publish*)"
         --deny "Edit(**/.env*)" --deny "Write(**/.env*)")
  : "${MAX_TURNS:=60}"
else
  # read-only is enforced by the kernel, so permissions can be permissive:
  # the worker gets the full toolset (incl. shell) and simply cannot write.
  SANDBOX=read-only
  SAFE+=(--sandbox "$SANDBOX" --permission-mode bypassPermissions)
  : "${MAX_TURNS:=30}"
fi
[[ -n "$TOOLS" ]] && SAFE+=(--tools "$TOOLS")
SAFE+=(--disallowed-tools "Agent")
[[ "$WEB" -eq 0 ]] && SAFE+=(--disable-web-search)
# MCP servers are separate processes OUTSIDE the kernel sandbox, so a "read-only"
# worker could still perform remote writes through them (e.g. signoz_delete_alert).
[[ "$MCP" -eq 0 ]] && SAFE+=(--deny "MCPTool(*)")
for r in ${XALLOW+"${XALLOW[@]}"}; do SAFE+=(--allow "$r"); done
for r in ${XDENY+"${XDENY[@]}"};  do SAFE+=(--deny  "$r"); done

# Session/schema flags are per-phase; containment is not.
ARGS=(${SAFE+"${SAFE[@]}"})

SCHEMA=""
if [[ "$USE_SCHEMA" -eq 1 ]]; then
  if [[ -n "$SCHEMA_FILE" ]]; then
    [[ -f "$SCHEMA_FILE" ]] || die "no such schema: $SCHEMA_FILE"
    SCHEMA="$(cat "$SCHEMA_FILE")"
  else SCHEMA="$DEFAULT_SCHEMA"; fi
  jq -e . >/dev/null 2>&1 <<<"$SCHEMA" || die "schema is not valid JSON"
  # Two-phase by default. Constrained decoding competes with the tool loop: the model
  # can emit a schema-shaped answer on turn 1 *instead of* calling any tools, and it
  # does so nondeterministically -- an empty result that looks like a clean success.
  # So phase 1 runs free-form, and phase 2 resumes the same session purely to format.
  [[ "$SCHEMA_INLINE" -eq 1 ]] && ARGS+=(--json-schema "$SCHEMA")
fi
if [[ -n "$SESSION" ]]; then
  ARGS+=(--resume "$SESSION"); PRESET_SID="$SESSION"
else
  # We choose the UUID up front rather than learning it from the worker's output:
  # on timeout there IS no output, and an unaddressable session means the work is lost.
  PRESET_SID="$(uuidgen | tr '[:upper:]' '[:lower:]')"
  ARGS+=(-s "$PRESET_SID")
fi

# ---------- run dir ----------
slug="$(printf '%s' "${LABEL:-$SUB}" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//;s/-*$//' | cut -c1-32)"
RUN_ID="$(date +%Y%m%d-%H%M%S)-${slug:-task}-$$"
D="$CCX_HOME/runs/$RUN_ID"; mkdir -p "$D"
printf '%s\n' "$BRIEF" > "$D/brief.md"
# Record the session BEFORE dispatching. ccx's own timeout path is not the only way a
# run dies -- an external SIGTERM (harness limit, ctrl-c, sleep) kills us before we can
# report anything, and the worker's context is only recoverable if the id was written down.
jq -n --arg r "$RUN_ID" --arg s "$PRESET_SID" --arg cwd "$CWD" --arg p "$PROFILE" \
      --arg m "$MODEL" --arg ef "$EFFORT" --arg to "$TIMEOUT" \
  '{run:$r,session:$s,cwd:$cwd,profile:$p,model:$m,effort:$ef,
    timeout_s:($to|tonumber),status:"running"}' > "$D/meta.json"

# ---------- observability: capture the exact invocation ----------
# The single most useful debugging artifact is what was ACTUALLY passed to grok.
# Long values (schemas, rules) are truncated so the record stays readable.
declare -a WARN=()
CMD_JSON=$(printf '%s\n' "${ARGS[@]}" \
  | jq -R 'if length > 160 then .[0:160] + "…[truncated]" else . end' | jq -sc .)

# ---------- dispatch ----------
START=$(date +%s)
set +e
timeout --kill-after=30s "$TIMEOUT" "$GROK_BIN" --no-auto-update \
  -p "$BRIEF" --cwd "$CWD" -m "$MODEL" --reasoning-effort "$EFFORT" \
  --rules "$WORKER_RULES" --max-turns "$MAX_TURNS" \
  --output-format json "${ARGS[@]}" >"$D/raw.json" 2>"$D/stderr.log"
RC=$?
set -e
ELAPSED=$(( $(date +%s) - START ))
P1_SECONDS=$ELAPSED
P2_SECONDS=0

if [[ $RC -eq 124 || $RC -eq 137 ]]; then
  jq -n --arg r "$RUN_ID" --arg t "$TIMEOUT" --arg s "$PRESET_SID" --arg cwd "$CWD" \
    '{run:$r,status:"timeout",session:$s,cwd:$cwd,
      note:("worker exceeded " + $t + "s; its context is intact -- resume it")}' > "$D/meta.json"
  cat "$D/meta.json"
  cat >&2 <<EOM
ccx: worker hit the ${TIMEOUT}s limit. The work is NOT lost -- the session still holds it:
  ccx cont --session $PRESET_SID -- "Stop investigating. Report what you have found so far."
Or re-run with a longer budget: --timeout $((TIMEOUT * 2))
EOM
  exit 4
fi

if ! jq -e . >/dev/null 2>&1 <"$D/raw.json"; then
  echo "ccx: worker produced no parseable JSON (exit $RC). stderr:" >&2
  tail -20 "$D/stderr.log" >&2; exit 5
fi

SID=$(jq -r '.sessionId // ""' "$D/raw.json"); SID="${SID:-$PRESET_SID}"
COST=$(jq -r '.total_cost_usd // 0' "$D/raw.json")
TURNS=$(jq -r '.num_turns // 0' "$D/raw.json")
STOP=$(jq -r '.stopReason // "?"' "$D/raw.json")

# ---------- phase 2: format the finished work into the envelope ----------
if [[ "$USE_SCHEMA" -eq 1 && "$SCHEMA_INLINE" -eq 0 && -n "$SID" ]]; then
  mv "$D/raw.json" "$D/raw1.json"
  set +e
  timeout --kill-after=15s 180 "$GROK_BIN" --no-auto-update \
    -p "Now return the result of the work you just did as JSON matching the required schema. Base it ENTIRELY on what you already found; do not investigate further and do not use any tools. If you did not actually complete the work, say so honestly with status=partial or blocked rather than returning an empty result." \
    --cwd "$CWD" -m "$MODEL" --reasoning-effort low --resume "$SID" \
    ${SAFE+"${SAFE[@]}"} \
    --max-turns 1 --json-schema "$SCHEMA" --output-format json \
    >"$D/raw2.json" 2>>"$D/stderr.log"
  RC2=$?
  set -e
  P2_SECONDS=$(( $(date +%s) - START - P1_SECONDS ))
  [[ $RC2 -ne 0 ]] && WARN+=("phase2-format-failed")
  if [[ $RC2 -eq 0 ]] && jq -e '.structuredOutput' >/dev/null 2>&1 <"$D/raw2.json"; then
    C2=$(jq -r '.total_cost_usd // 0' "$D/raw2.json")
    COST=$(python3 -c "print(round($COST + $C2, 8))" 2>/dev/null || echo "$COST")
    jq -s '.[0] * {structuredOutput: .[1].structuredOutput}' "$D/raw1.json" "$D/raw2.json" > "$D/raw.json"
  else
    echo "ccx: warning: envelope formatting pass failed; falling back to prose" >&2
    cp "$D/raw1.json" "$D/raw.json"
  fi
fi

if [[ "$USE_SCHEMA" -eq 1 ]] && jq -e '.structuredOutput' >/dev/null 2>&1 <"$D/raw.json"; then
  jq '.structuredOutput' "$D/raw.json" > "$D/envelope.json"
  STATUS=$(jq -r '.status // "done"' "$D/envelope.json")
else
  jq -r '.text // ""' "$D/raw.json" > "$D/envelope.json"; STATUS="$STOP"
fi

# Must precede serialisation: these were previously appended after meta.json was
# written, so the two most diagnostic warnings never reached meta.json, runs.jsonl,
# ccx stats or the OTLP export -- only stderr.
if [[ "$TURNS" -le 1 && "$P1_SECONDS" -lt 20 ]]; then
  WARN+=("suspected-short-circuit: $TURNS turn in ${P1_SECONDS}s, may not have used tools")
  echo "ccx: warning: worker finished in $TURNS turn / ${P1_SECONDS}s -- it may not have used any tools. Check: ccx show $RUN_ID --transcript" >&2
fi
[[ "$STATUS" == "blocked" ]] && WARN+=("worker-blocked: brief likely underspecified")

WARN_JSON=$(printf '%s\n' ${WARN+"${WARN[@]}"} | jq -R . | jq -sc 'map(select(length>0))')
jq -n --arg r "$RUN_ID" --arg s "$SID" --arg st "$STATUS" --arg c "$COST" \
      --arg t "$TURNS" --arg e "$ELAPSED" --arg cwd "$CWD" --arg m "$MODEL" --arg ef "$EFFORT" \
      --arg gv "$GROK_VER" --arg p "$PROFILE" --arg lb "${LABEL:-$SUB}" --arg sub "$SUB" \
      --arg p1 "$P1_SECONDS" --arg p2 "$P2_SECONDS" --arg rc "$RC" --arg stop "$STOP" \
      --argjson cmd "$CMD_JSON" --argjson warn "$WARN_JSON" \
      --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg bb "$(wc -c < "$D/brief.md" | tr -d ' ')" \
  '{ts:$ts,run:$r,session:$s,sub:$sub,label:$lb,status:$st,stop_reason:$stop,
    cost:($c|tonumber),turns:($t|tonumber),seconds:($e|tonumber),
    phase1_seconds:($p1|tonumber),phase2_seconds:($p2|tonumber),
    brief_bytes:($bb|tonumber),exit_code:($rc|tonumber),
    cwd:$cwd,model:$m,effort:$ef,profile:$p,grok:$gv,warnings:$warn,cmd:$cmd}' > "$D/meta.json"
# Append-only event log: one compact line per run, so `jq -s` over a single file
# answers "what did this cost / what keeps failing" without globbing run dirs.
jq -c '{ts,run,label,sub,status,profile,effort,cost,turns,seconds,phase1_seconds,
        phase2_seconds,brief_bytes,exit_code,warnings,grok,cwd}' "$D/meta.json" \
  >> "$CCX_HOME/runs.jsonl" 2>/dev/null || true

# ---------- report (small!) ----------
if [[ "$RAW" -eq 0 ]]; then
  printf 'run %s | session %s | %s turns | %ss | $%s\n' "$RUN_ID" "${SID:0:8}" "$TURNS" "$ELAPSED" "$COST"
  printf 'cwd %s\n' "$CWD"
  printf 'full transcript: ccx show %s --transcript\n' "$RUN_ID"
  [[ -n "$SID" ]] && printf 'continue:        ccx cont --session %s -- "<followup>"\n' "$SID"
  printf -- '---\n'
fi

SZ=$(wc -c < "$D/envelope.json" | tr -d ' ')
if [[ "$SZ" -gt "$MAX_OUT" ]]; then
  head -c "$MAX_OUT" "$D/envelope.json"
  printf '\n... [truncated %s bytes; full: %s/envelope.json]\n' "$((SZ-MAX_OUT))" "$D"
else
  cat "$D/envelope.json"; echo
fi

case "$STATUS" in blocked) exit 3 ;; *) exit 0 ;; esac
